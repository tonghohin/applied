# Docker images to pull (published to GHCR when you push to main)
WEB_IMAGE=ghcr.io/tonghohin/applied-web:latest
WORKER_IMAGE=ghcr.io/tonghohin/applied-worker:latest

# Public URL where the app will be served (used by Better Auth for redirects
# and baked into the web client at build time)
APP_URL=http://localhost:8420

# Change to run the app on a different host port
WEB_PORT=8420

# Interface the port binds to. 127.0.0.1 keeps the app reachable only from this
# machine; 0.0.0.0 opens it to your network (update APP_URL to match)
WEB_HOST=127.0.0.1

# Required. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Database password for the app's Postgres container
DB_PASSWORD=applied

# Required. Generate with: openssl rand -hex 32
# Encrypts your LinkedIn login and AI key. If you lose it, re-enter both in Settings
ENCRYPTION_KEY=
