# Database
DATABASE_URL=postgresql://applied:applied@localhost:5432/applied

# Better Auth
BETTER_AUTH_SECRET=your-secret-here-min-32-chars
BETTER_AUTH_URL=http://localhost:3001

# Google OAuth (for sign in with Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# CORS — web app origin (allowed by the Hono server)
ALLOWED_ORIGIN=http://localhost:3000

# Gemini AI (used by packages/ai)
GEMINI_API_KEY=

# LinkedIn credential encryption (AES-256-GCM key, 32 bytes hex)
LINKEDIN_ENCRYPTION_KEY=
